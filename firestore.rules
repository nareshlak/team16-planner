rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google accounts can read or edit the planner.
    // Use lowercase, keep the quotes and commas.
    function onTeam() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'teammate1@gmail.com',
          'teammate2@gmail.com',
          'teammate3@gmail.com',
          'teammate4@gmail.com',
          'teammate5@gmail.com',
          'teammate6@gmail.com',
          'teammate7@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if onTeam();
    }
  }
}
